# Convex deployment URL consumed by the desktop renderer.
# Produced by `npx convex dev`; copy the value it prints for your deployment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Written by the Convex CLI. Never commit the real value.
CONVEX_DEPLOYMENT=

# Clerk publishable key (pk_test_… for the development instance). Sign-in is on only when set.
# The Convex deployment also needs CLERK_JWT_ISSUER_DOMAIN (set with `npx convex env set`).
VITE_CLERK_PUBLISHABLE_KEY=
